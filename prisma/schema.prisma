generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                String                   @id @default(cuid())
  name              String
  retentionDays     Int                      @default(2555)
  noticeVersion     String                   @default("2026-08")
  createdAt         DateTime                 @default(now())
  users             User[]
  students          Student[]
  auditLogs         AuditLog[]
  reportingPeriods  ReportingPeriodWindow[]
  reportSnippets    ReportSnippet[]
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  title          String?
  role           String
  passwordHash   String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lastLoginAt    DateTime?
  failedSignIns  Int       @default(0)
  lockedUntil    DateTime?
  totpSecret     String?
  totpEnabledAt  DateTime?
  createdAt      DateTime  @default(now())
  deactivatedAt  DateTime?

  managedStudents   Student[]              @relation("CaseManager")
  providerLinks     StudentProvider[]
  guardianLinks     GuardianContact[]
  progressEntries   ProgressEntry[]
  messages          Message[]
  auditLogs         AuditLog[]
  createdGoals      IepGoal[]              @relation("GoalAuthor")
  periodStatements  GoalPeriodStatement[]
  goalVersions      GoalVersion[]
  reportSnippets    ReportSnippet[]
  messageReads      MessageRead[]
  meetingAttendances MeetingAttendance[]
  filedDocuments     FiledDocument[]

  @@index([organizationId, role])
}

model Student {
  id                String    @id @default(cuid())
  preferredName     String
  grade             String
  school            String
  caseManagerId     String
  caseManager       User      @relation("CaseManager", fields: [caseManagerId], references: [id])
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  iepAnnualReviewAt DateTime?
  iepTriennialAt    DateTime?
  presentLevels     String?

  providers  StudentProvider[]
  guardians  GuardianContact[]
  goals      IepGoal[]
  messages       Message[]
  consents       ConsentRecord[]
  accommodations StudentAccommodation[]
  attendances    MeetingAttendance[]
  filedDocuments FiledDocument[]

  @@index([organizationId])
  @@index([caseManagerId])
}

model StudentProvider {
  studentId       String
  userId          String
  serviceArea     String
  minutesPerWeek  Int     @default(0)
  sessionsPerWeek Int     @default(0)
  student         Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([studentId, userId])
}

model GuardianContact {
  id                    String    @id @default(cuid())
  studentId             String
  student               Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name                  String
  relationship          String
  email                 String
  phone                 String?
  userId                String?
  user                  User?     @relation(fields: [userId], references: [id])
  digestOptIn           Boolean   @default(false)
  digestUnsubscribedAt  DateTime?
}

model IepGoal {
  id                         String    @id @default(cuid())
  studentId                  String
  student                    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  officialWording            String
  plainLanguageSummary       String
  baseline                   String
  measurableTarget           String
  targetValue                Float
  unit                       String
  reportingPeriod            String
  nextReportDue              DateTime
  serviceArea                String
  measurementMethod          String
  status                     String
  startDate                  DateTime
  endDate                    DateTime?
  sharedWithGuardians        Boolean   @default(true)
  consecutiveSessionsNeeded  Int       @default(1)
  maxPromptForMastery        String    @default("INDEPENDENT")
  presentLevelsSnapshot      String?
  createdById                String
  createdBy                  User      @relation("GoalAuthor", fields: [createdById], references: [id])
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  entries                    ProgressEntry[]
  objectives                 GoalObjective[]
  periodStatements           GoalPeriodStatement[]
  versions                   GoalVersion[]

  @@index([studentId])
  @@index([nextReportDue])
}

model GoalObjective {
  id                   String   @id @default(cuid())
  goalId               String
  goal                 IepGoal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  officialWording      String
  plainLanguageSummary String
  targetValue          Float
  unit                 String
  status               String   @default("ACTIVE")
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  entries              ProgressEntry[]

  @@index([goalId])
}

model ProgressEntry {
  id               String   @id @default(cuid())
  goalId           String
  goal             IepGoal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  recordedAt       DateTime
  score            Float
  measurementType  String
  notes            String
  evidenceLabel    String?
  evidencePath     String?
  authorId         String
  author           User     @relation(fields: [authorId], references: [id])
  createdAt        DateTime @default(now())
  sessionOutcome   String   @default("PRESENT")
  setting          String   @default("CLASSROOM")
  conditionTag     String?
  accommodations   String?
  minutesDelivered Int?
  groupSize        Int?
  homeCarryover    String?
  objectiveId          String?
  objective            GoalObjective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  trials               ProgressTrial[]
  makeupScheduledFor   DateTime?
  makeupLocation       String?

  @@index([goalId, recordedAt])
}

model ProgressTrial {
  id          String        @id @default(cuid())
  entryId     String
  entry       ProgressEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  result      String
  promptLevel String        @default("INDEPENDENT")
  sortOrder   Int           @default(0)
}

model ReportingPeriodWindow {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String
  startsAt       DateTime
  endsAt         DateTime
  statements     GoalPeriodStatement[]

  @@index([organizationId, startsAt])
}

model GoalPeriodStatement {
  id           String                 @id @default(cuid())
  goalId       String
  goal         IepGoal                @relation(fields: [goalId], references: [id], onDelete: Cascade)
  periodId     String
  period       ReportingPeriodWindow  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  progressCode String
  narrative    String
  authorId      String
  author        User                   @relation(fields: [authorId], references: [id])
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  goalVersionId String?
  goalVersion   GoalVersion?           @relation(fields: [goalVersionId], references: [id], onDelete: SetNull)

  @@unique([goalId, periodId])
}

model Message {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User     @relation(fields: [fromUserId], references: [id])
  body       String
  createdAt  DateTime @default(now())
  visibility String   @default("FAMILY")
  reads      MessageRead[]

  @@index([studentId, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  action         String
  resourceType   String
  resourceId     String
  studentId      String?
  details        String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([studentId])
}

model ConsentRecord {
  id            String    @id @default(cuid())
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianName  String
  noticeVersion String
  grantedAt     DateTime
  withdrawnAt   DateTime?
}

model StudentAccommodation {
  id         String    @id @default(cuid())
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  label      String
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([studentId])
}

model GoalVersion {
  id                        String   @id @default(cuid())
  goalId                    String
  goal                      IepGoal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  officialWording           String
  plainLanguageSummary      String
  baseline                  String
  measurableTarget          String
  targetValue               Float
  unit                      String
  measurementMethod         String
  presentLevelsSnapshot     String?
  consecutiveSessionsNeeded Int
  maxPromptForMastery       String
  changeReason              String
  createdById               String
  createdBy                 User     @relation(fields: [createdById], references: [id])
  createdAt                 DateTime @default(now())
  periodStatements          GoalPeriodStatement[]

  @@index([goalId, createdAt])
}

model ReportSnippet {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  label          String
  body           String
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model MessageRead {
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

model MeetingAttendance {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  meetingOn    DateTime
  attendeeName String
  present      Boolean  @default(true)
  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  @@unique([studentId, meetingOn, attendeeName])
  @@index([studentId, meetingOn])
}

model FiledDocument {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  organizationId String
  kind           String
  periodLabel    String?
  storagePath    String
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([organizationId])
}
