# IEP Progress Tracker — environment template
# Copy to .env.local and fill in secrets. Never commit .env.local.
# Uncomment a block only when you need it. Later values do not “merge” with earlier ones.

# -----------------------------------------------------------------------------
# Local development (required)
# -----------------------------------------------------------------------------
# Postgres: npm run docker:db. Changing POSTGRES_* after the first start does
# not update an existing volume (docker compose --env-file .env.local down -v).
POSTGRES_USER="iep"
POSTGRES_PASSWORD="iep"
POSTGRES_DB="iep"
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT="5432"

# Auth.js session signing. Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32"

# Public origin. Must match how you open the app (scheme + host + port).
# npm run dev:            http://127.0.0.1:43147
# npm run dev:https / Compose: https://127.0.0.1:43147  (Compose sets this itself)
AUTH_URL="http://127.0.0.1:43147"

# Keep true until seed data is gone. Production: false, then /api/health must
# report "demo": false before real students.
NEXT_PUBLIC_DEMO_MODE="true"

# UI name. Slug is used for demo emails and export filenames; omit SLUG to
# derive it from the name (hyphenated, lowercase).
NEXT_PUBLIC_APP_NAME="IEP Progress Tracker"
NEXT_PUBLIC_APP_SLUG="iep-progress-tracker"

# Idle sign-out in minutes. Default 20. 0 disables (Playwright uses 0).
# NEXT_PUBLIC_IDLE_MINUTES="20"

# -----------------------------------------------------------------------------
# Demo accounts (optional)
# -----------------------------------------------------------------------------
# Defaults: domain demo.{slug}.school, passphrase Iep-progress-tracker!Demo26
# NEXT_PUBLIC_DEMO_EMAIL_DOMAIN="demo.iep-progress-tracker.school"
# NEXT_PUBLIC_DEMO_PASSPHRASE="Iep-progress-tracker!Demo26"

# -----------------------------------------------------------------------------
# Hosted Postgres (Vercel / Supabase / Neon) — skip for local Docker
# -----------------------------------------------------------------------------
# Priority at runtime: DATABASE_URL, then POSTGRES_PRISMA_URL, then POSTGRES_URL,
# then the POSTGRES_* parts above. A blank DATABASE_URL is ignored.
#
# Supabase: Dashboard → Connect → URI. Use the transaction pooler (port 6543)
# for DATABASE_URL and the session/direct URI (port 5432) for DIRECT_URL.
# Skip the “Direct connection” host. Add pgbouncer=true on the pooler URL.
# DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
#
# Neon / Vercel Postgres (also accept POSTGRES_DATABASE as an alias for POSTGRES_DB):
# POSTGRES_PRISMA_URL=""
# POSTGRES_URL=""
# POSTGRES_URL_NON_POOLING=""

# -----------------------------------------------------------------------------
# Evidence storage (required when NEXT_PUBLIC_DEMO_MODE=false)
# -----------------------------------------------------------------------------
# Pick one. Disk is local-dev / hosted-demo only. Keep one app replica until
# object storage is proven.
#
# Supabase Storage (private bucket; created on first upload if missing).
# Never expose SUPABASE_SERVICE_ROLE_KEY as NEXT_PUBLIC_*.
# SUPABASE_URL="https://PROJECTREF.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_EVIDENCE_BUCKET="iep-evidence"
#
# Vercel Blob instead of Supabase:
# BLOB_READ_WRITE_TOKEN=""

# -----------------------------------------------------------------------------
# Email (optional) — pick one. Unset = no mail.
# -----------------------------------------------------------------------------
# Used for team invites, deactivate/reactivate notices, family-message pings,
# reporting-window notices, and opted-in weekly family digests. Subjects never
# include goal text.
#
# 1) Local Mailpit (npm run docker:db). Inbox: http://127.0.0.1:8025
# SMTP_HOST="127.0.0.1"
# SMTP_PORT="1025"
# MAIL_FROM="noreply@localhost"
#
# 2) Resend API (Vercel / production). When RESEND_API_KEY is set to a real
#    re_… key, SMTP is unused. Create a key at https://resend.com/api-keys
#    and replace re_xxxxxxxxx. The placeholder is ignored.
#    Test domain onboarding@resend.dev only delivers to your Resend account
#    email. Production: verify a district domain, then set MAIL_FROM to it.
# RESEND_API_KEY="re_xxxxxxxxx"
# MAIL_FROM="onboarding@resend.dev"
#
# 3) District SMTP relay (if not using Resend)
# SMTP_HOST="smtp.district.edu"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# MAIL_FROM="noreply@district.edu"

# -----------------------------------------------------------------------------
# Cron and family digest
# -----------------------------------------------------------------------------
# Bearer token for GET/POST /api/cron/daily (retention, reporting-window mail,
# Friday digest). Vercel Cron sends this automatically when the var is set.
# CRON_SECRET=""
# Set 1 to send opted-in digests on any weekday (local tests). Production
# sends on Friday UTC — leave this unset there.
# DIGEST_SEND=""

# -----------------------------------------------------------------------------
# School SSO (optional)
# -----------------------------------------------------------------------------
# Callbacks: {AUTH_URL}/api/auth/callback/{provider}
#   Microsoft  /api/auth/callback/microsoft-entra-id
#   Google     /api/auth/callback/google
#   OIDC       /api/auth/callback/oidc
# Pre-provision staff in Team with the same email the IdP will send.
# Unknown emails are rejected unless JIT is on. Do not use JIT for parents.
#
# Microsoft Entra ID — tenant issuer, not "common":
# AUTH_MICROSOFT_ENTRA_ID_ID=""
# AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/{tenant-id}/v2.0"
#
# Google Workspace:
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_GOOGLE_HOSTED_DOMAIN="district.edu"
#
# Generic OIDC (Okta, ClassLink, Auth0, …):
# AUTH_OIDC_ISSUER=""
# AUTH_OIDC_ID=""
# AUTH_OIDC_SECRET=""
# AUTH_OIDC_NAME="ClassLink"
#
# AUTH_SSO_ALLOWED_DOMAINS="district.edu"
# AUTH_SSO_JIT_PROVISION="false"
# AUTH_SSO_JIT_ROLE="EDUCATOR"
# AUTH_SSO_ORGANIZATION_ID=""
#
# Password sign-in. When demo is off and SSO is configured, credentials stay
# off unless this is explicitly true. Set false in production after SSO works.
# AUTH_CREDENTIALS_ENABLED="true"

# -----------------------------------------------------------------------------
# How-to chatbot (optional)
# -----------------------------------------------------------------------------
# Unset = in-app handbook only. Token rephrases those answers via Hugging Face
# Inference Providers. Never send student records. Also accepts
# HUGGINGFACE_HUB_TOKEN. Create a token (read / inference):
# https://huggingface.co/settings/tokens
# HF_TOKEN=""
# HF_CHAT_MODEL="Qwen/Qwen2.5-3B-Instruct:cheapest"
# HF_CHAT_BASE_URL="https://router.huggingface.co/v1"

# -----------------------------------------------------------------------------
# Error monitoring (optional)
# -----------------------------------------------------------------------------
# Do not send student payloads. Requires adding @sentry/nextjs separately.
# SENTRY_DSN=""
# Optional how-to chatbot via Hugging Face (monthly free credits). Unset = in-app guide only.
# Create a token at https://huggingface.co/settings/tokens (read / inference).
# HF_TOKEN=""
# HF_CHAT_MODEL="Qwen/Qwen2.5-3B-Instruct:cheapest"
# HF_CHAT_BASE_URL="https://router.huggingface.co/v1"

# Vercel + Supabase — Connect → URI (transaction 6543, session 5432). Skip Direct.
# DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
# SUPABASE_URL="https://PROJECTREF.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_EVIDENCE_BUCKET="iep-evidence"

# Neon / Blob instead of Supabase
# POSTGRES_URL=""
# POSTGRES_PRISMA_URL=""
# POSTGRES_URL_NON_POOLING=""
# BLOB_READ_WRITE_TOKEN=""

# SSO — callbacks at {AUTH_URL}/api/auth/callback/{provider}
# AUTH_MICROSOFT_ENTRA_ID_ID=""
# AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/{tenant-id}/v2.0"
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_GOOGLE_HOSTED_DOMAIN="district.edu"
# AUTH_OIDC_ISSUER=""
# AUTH_OIDC_ID=""
# AUTH_OIDC_SECRET=""
# AUTH_OIDC_NAME="ClassLink"
# AUTH_SSO_ALLOWED_DOMAINS="district.edu"
# AUTH_SSO_JIT_PROVISION="false"
# AUTH_SSO_JIT_ROLE="EDUCATOR"
# AUTH_SSO_ORGANIZATION_ID=""
# AUTH_CREDENTIALS_ENABLED="true"
# NEXT_PUBLIC_IDLE_MINUTES="20"
# CRON_SECRET=""
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# MAIL_FROM="noreply@district.edu"
